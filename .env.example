# 应用基础配置
# 含空格或特殊字符的值请使用双引号包裹。
# 安装完成后，如已启用配置缓存，修改 .env 后需执行 php artisan config:cache。
# Laravel 应用名称；后台品牌名称单独使用下方 PTADMIN_BRAND_NAME。
APP_NAME=PTAdmin
# 生产环境使用 production，本地开发可使用 local。
APP_ENV=production
# 应用加密密钥，由 PTAdmin 安装向导生成，无需预先填写。
APP_KEY=
# 是否展示调试详情；生产环境保持 false。
APP_DEBUG=false
# 应用公开访问地址，如 https://admin.example.com；用于生成链接和资源地址。
APP_URL=
# 默认语言及缺少翻译时使用的回退语言。
APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en

# 后台入口由安装向导设置；未指定时生成随机路径，无需预先填写 PTADMIN_WEB_PREFIX。

# 后台品牌与登录页
# 这些部署配置通过 /ptadmin/bootstrap 公开，与前台站点设置独立。
# 产品介绍和标语需配套支持 login_intro / login_slogan 的 Core 与 Admin Shell。
# 后台侧栏名称、Logo 替代文本及浏览器标题；登录页不在 Logo 后重复显示名称。
PTADMIN_BRAND_NAME="PTAdmin"
# 三处 Logo 的共用 URL，可填写完整地址或 public 下的相对路径，如 branding/logo.svg。
# 留空使用内置 Logo；专用 Logo URL 优先于此配置。
PTADMIN_BRAND_LOGO_URL=""
# 登录表单标题；未配置或留空时使用“登录管理后台”。
PTADMIN_LOGIN_TITLE="登录管理后台"
# 右侧标题下方的产品介绍；未配置使用以下默认文案，设置为 "" 时隐藏。
PTADMIN_LOGIN_INTRO="基于 Laravel 的后台管理与应用扩展平台。"
# 左侧 Logo 下方的品牌标语；未配置使用以下默认文案，设置为 "" 时隐藏。
PTADMIN_LOGIN_SLOGAN="让应用开发更简单。"
# 后台侧栏专用 Logo，建议使用方形图案；留空使用共用 Logo 或内置标识。
PTADMIN_BRAND_SIDEBAR_LOGO_URL=""
# 登录表单上方的专用 Logo，适合浅色背景；留空使用共用 Logo 或内置标识。
PTADMIN_BRAND_LOGIN_PANEL_LOGO_URL=""
# 登录页左侧专用 Logo，适合深色背景，可使用反白版本；留空使用共用 Logo 或内置标识。
PTADMIN_BRAND_LOGIN_ART_LOGO_URL=""
# Logo 尺寸在宿主 config/ptadmin.php 的 brand.logos 中设置，不通过 .env 配置。

# 日志配置
# daily 按天写入 storage/logs，并按 config/logging.php 的保留天数轮换。
LOG_CHANNEL=daily
# 弃用提示的日志通道；null 表示不记录。
LOG_DEPRECATIONS_CHANNEL=null
# 最低记录级别，如 debug、info、warning、error。
LOG_LEVEL=debug

# 数据库配置
# 安装向导会根据所选数据库写入连接信息，安装前无需手动连接或创建业务表。
# 支持通过安装向导选择 mysql 或 sqlite；以下为 MySQL 示例。
DB_CONNECTION=mysql
# MySQL 地址和端口；使用 SQLite 时不使用这两项。
DB_HOST=127.0.0.1
DB_PORT=3306
# MySQL 数据库名称；SQLite 安装时由向导写入 storage/database 下的文件路径。
DB_DATABASE=
# 数据库账号和密码；使用 SQLite 时不使用这两项。
DB_USERNAME=
DB_PASSWORD=
# 数据表前缀，应在安装前确定；修改此值不会自动重命名已有表。
DB_PREFIX=pt_

# 广播、缓存、文件与会话
# log 将广播事件写入日志，不连接外部广播服务。
BROADCAST_DRIVER=log
# 当前应用读取 CACHE_DRIVER；file 将缓存保存在 storage/framework/cache/data。
CACHE_DRIVER=file
# 当前应用读取 FILESYSTEM_DRIVER；local 的文件根目录为 storage/app。
FILESYSTEM_DRIVER=local
# sync 在当前进程执行 Laravel 队列任务；切换其他驱动时需配置对应队列及消费者。
QUEUE_CONNECTION=sync
# Laravel Web 会话使用文件存储；此项不控制后台 Bearer Token 的有效期。
SESSION_DRIVER=file
# Web 会话空闲有效期，单位为分钟。
SESSION_LIFETIME=120

# SMTP 邮件配置
# 安装时作为系统邮件配置的初始默认值；安装后在后台邮件设置中维护实际发送配置。
# SMTP 服务地址，如 smtp.example.com。
MAIL_HOST=
# SMTP 登录账号及密码或服务商提供的授权码。
MAIL_USERNAME=
MAIL_PASSWORD=
# 发件人邮箱及展示名称，邮箱需符合服务商的发信要求。
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
# SMTP 端口，通常 ssl 对应 465、tls 对应 587，以服务商要求为准。
MAIL_PORT=
# 加密方式：ssl 为隐式 TLS，tls 为 STARTTLS；留空表示不强制指定加密方式。
MAIL_ENCRYPTION=ssl
