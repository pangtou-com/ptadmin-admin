{
    "name": "ptadmin/admin",
    "type": "project",
    "description": "PTAdmin base Laravel application for composer create-project.",
    "keywords": [
        "framework",
        "laravel",
        "admin",
        "application",
        "快速开发"
    ],
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Zane",
            "email": "873934580@qq.com"
        }
    ],
    "require": {
        "php": ">=8.2 <9.0",
        "laravel/framework": "^12.68",
        "ptadmin/core": "^0.7.0",
        "bacon/bacon-qr-code": "^2.0",
        "doctrine/dbal": "^3.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {"App\\": "app/"}
    },
    "autoload-dev": {
        "psr-4": {"Tests\\": "tests/"}
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan storage:link"
        ],
        "test": "phpunit -c phpunit.xml"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
